<div class="container">

    <h1>String Functions and Regular Expressions</h1>

    <!-- EMAIL VALIDATION -->
    <div class="section">
        <h2>1. Email Validation</h2>

        <p>
            Checks string validity using literal trimming and strict pattern matching.
        </p>

        <div class="input-row">
            <input
                type="text"
                id="emailInput"
                value="kashish35@gmail.com"
                placeholder="Enter email address"
            >

            <button onclick="validateEmail()">Validate</button>
        </div>

        <div id="emailResult" class="result"></div>
    </div>


    <!-- DATA EXTRACTION -->
    <div class="section">

        <h2>2. Data Extraction</h2>

        <p>
            Extracts all valid emails, system dates (YYYY-MM-DD), and ticket IDs
            (#123) from messy text.
        </p>

        <div class="grid">

            <!-- LEFT SIDE -->
            <div>
                <textarea id="textInput">2007-01-31</textarea>

                <br><br>

                <button onclick="extractMetadata()">
                    Extract Metadata
                </button>

                <div id="leftReport" class="report">
                    ### Extraction Report ###
                </div>
            </div>


            <!-- RIGHT SIDE -->
            <div>

                <textarea id="sampleText">Email 1: office@example.com
Phone 1: 555-0199
Phone 2: +1-123-456-7890
Message: Please call or email us today.</textarea>

                <br><br>

                <button onclick="extractSampleData()">
                    Extract Metadata
                </button>

                <div id="rightReport" class="report">
                    ### Extraction Report ###
                </div>

            </div>

        </div>
    </div>


    <!-- TEXT ANALYSIS -->
    <div class="section">

        <h2>3. Text Analysis</h2>

        <textarea id="analysisText"
            placeholder="Enter text for analysis...">Hello! This is a JavaScript Regex experiment.</textarea>

        <br><br>

        <button onclick="analyzeText()">Analyze Text</button>

        <div id="analysisResult" class="analysis"></div>

    </div>

